# DeepSeek API (https://platform.deepseek.com). OpenAI-compatible.
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PLAN_MODEL=deepseek-reasoner
DEEPSEEK_COMPILE_MODEL=deepseek-chat
# Directory to cache compiled choreographies (keyed by audio fingerprint).
CACHE_DIR=./cache
# Comma-separated origins allowed to call the API (CORS).
ALLOWED_ORIGINS=*
